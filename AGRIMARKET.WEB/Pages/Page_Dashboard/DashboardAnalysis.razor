@page "/"
@page "/AgriMkt/Dash"
@inject IApiMarketService service
@inject ILogger<DashboardAnalysis> logger
@layout DashboardLayout
<PageTitle>AgriMarket | Creating Opportinuities</PageTitle>

<div class="py-3 px-4">
    @if (loading)
    {
        <DataLoader />

    }
    else if (prices.Count == 0)
    {
        <div class="alert alert-warning">Iiom
            No market price data available.
        </div>
    }
    else
    {

        <div class="agrimarket-dashboard">
            <div class="dashboard-sticky-header">
                <div class="dashboard-header">
                    <div class="dashboard-brand">
                        <h1>AgriMarket Tanzania</h1>
                        <p>Daily Agriculture Price Trends</p>
                    </div>
                    <div class="table-status">
                        <span class="live-dot"></span>
                        <div class="status-text">
                            <small>Last Updated</small>
                            <strong class="badge bg-success">
                                @LastUpdated.ToString("dd MMM yyyy")
                            </strong>
                        </div>
                    </div>

                </div>
                <div class="dashboard-filters">
                    <div class="filter-group">
                        <label>Region</label>

                        <select @bind="selectedRegion"
                                @bind:after="RegionChanged">

                            <option value="">All regions</option>

                            @foreach (var region in Regions)
                            {
                                <option value="@region">
                                    @region
                                </option>
                            }

                        </select>
                    </div>


                    <div class="filter-group">
                        <label>Market</label>
                        <select @bind="selectedMarket">
                            <option value="">All markets</option>
                            @foreach (var market in Markets)
                            {
                                <option value="@market">
                                    @market
                                </option>
                            }

                        </select>
                    </div>


                    <div class="filter-group">
                        <label>Commodity</label>

                        <select @bind="selectedCommodity">

                            <option value="">All commodities</option>

                            @foreach (var commodity in Commodities)
                            {
                                <option value="@commodity">
                                    @commodity
                                </option>
                            }

                        </select>
                    </div>

                </div>
                <div class="summary-grid">

                    <div class="summary-card">

                        <div class="summary-value">
                            TZS @AverageMaxPrice.ToString("N0")/=
                        </div>

                        <div class="summary-label">
                            Avg Max Price
                        </div>

                    </div>


                    <div class="summary-card">

                        <div class="summary-value">
                            TZS @AverageMinPrice.ToString("N0")/=
                        </div>

                        <div class="summary-label">
                            Avg Min Price
                        </div>

                    </div>

                    <div class="summary-card">
                        <div class="summary-value commodity-value">
                            @TopCommodity
                        </div>

                        <div class="summary-label">
                            Top Commodity
                        </div>

                    </div>
                    <div class="summary-card">
                        <div class="summary-value">
                            @CommodityCount
                        </div>

                        <div class="summary-label">
                            Commodity Count
                        </div>

                    </div>

                </div>

            </div>
            <main>
                <section class="dashboard-panel profitability-panel">
                    <div class="panel-title">
                        <div class="panel-heading">
                            <h6>
                                Find the Best Market
                            </h6>

                            <small class="small-word">
                                Compare market prices and road distance for your commodity
                            </small>
                        </div>

                        <div class="trend-status">
                            <span class="live-dot"></span>
                            MARKET ANALYSIS
                        </div>
                    </div>

                    <div class="dashboard-filters">
                        <div class="filter-group">
                            <label>Commodity</label>
                            <select @bind="profitCommodityId">
                                <option value="0">Select commodity</option>
                                @foreach (var commodity in prices.Where(x => x.CommodityId > 0).GroupBy(x => new { x.CommodityId, x.Commodity }).OrderBy(x => x.Key.Commodity))
                                {
                                    <option value="@commodity.Key.CommodityId">
                                        @commodity.Key.Commodity
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Quantity (KG)</label>
                            <input type="number" min="1"class="me-3" @bind="profitQuantity" />
                        </div>

                        <div class="filter-group">
                            <label>Origin Market</label>

                            <select @bind="profitOriginMarketId">

                                <option value="0">
                                    Select origin market
                                </option>

                                @foreach (var market in OriginMarkets)
                                {
                                    <option value="@market.Id">
                                        @market.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <button class="btn btn-outline-dark btn-sm rounded-circle d-flex align-items-center justify-content-center p-0 btn-round" @onclick="FindProfitableMarketsAsync" disabled="@profitLoading" title="Find Markets">
                            @if (profitLoading)
                            {
                                <span>Calculating...</span>
                            }
                            else
                            {
                                <span></span>
                            }

                        </button>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(profitError))
                    {
                        <div class="alert alert-warning mt-3">
                            @profitError
                        </div>
                    }

                    @if (profitResults.Any())
                    {
                        <div class="profitability-results mt-4">

                            <div class="profitability-result-header">
                                <div>
                                    <strong>Market Opportunities</strong>

                                    <small>
                                        @profitQuantity.ToString("N0") KG
                                    </small>
                                </div>

                                <span>
                                    @profitResults.Count markets
                                </span>
                            </div>

                            <div class="table-responsive">

                                <table class="table">

                                    <thead>
                                        <tr>
                                            <th>Market</th>
                                            <th>Price / KG</th>
                                            <th>Distance</th>
                                            <th>Travel Time</th>
                                            <th>Gross Revenue</th>
                                            <th>Estimated Net Revenue</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var market in profitResults)
                                        {
                                            <tr>

                                                <td>
                                                    <strong>
                                                        @market.MarketName
                                                    </strong>
                                                </td>

                                                <td>
                                                    TZS @market.PricePerUnit.ToString("N0")
                                                </td>

                                                <td>
                                                    @market.DistanceKm.ToString("N1") KM
                                                </td>

                                                <td>
                                                    @market.DurationMinutes.ToString("N0") min
                                                </td>

                                                <td>
                                                    TZS @market.GrossRevenue.ToString("N0")
                                                </td>

                                                <td class="price">
                                                    TZS @market.EstimatedNetRevenue.ToString("N0")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }

                </section>
                <div class="dashboard-chart-row">
                    <section class="dashboard-panel trend-panel">
                        <div class="panel-title">
                            <div class="panel-heading">
                                <h6>
                                    Market Price Trend At @DateTime.Now.ToString("HH:mm")
                                </h6>
                                <small class="small-word">
                                    @if (!string.IsNullOrWhiteSpace(selectedCommodity))
                                    {
                                        @selectedCommodity
                                    }
                                    else
                                    {
                                        @:Latest commodity price movement
                                    }
                                </small>
                            </div>
                            <div class="trend-status">
                                <span class="live-dot"></span>
                                LIVE TREND
                            </div>
                        </div>

                        @if (FilteredPrices.Any())
                        {
                            var trendData = FilteredPrices
                                .OrderBy(x => x.RecordedAt)
                                .TakeLast(12)
                                .ToList();
                            var maxChartPrice = trendData
                                .SelectMany(x => new[]
                                { x.MinPrice,x.Price, x.MaxPrice
                                })
                                .DefaultIfEmpty(1)
                                .Max();
                            <div class="trend-chart">
                                <div class="trend-y-axis">
                                    <span>
                                        TZS @maxChartPrice.ToString("N0")
                                    </span>
                                    <span>
                                        TZS @((maxChartPrice * .75m).ToString("N0"))
                                    </span>
                                    <span>
                                        TZS @((maxChartPrice * .50m).ToString("N0"))
                                    </span>
                                    <span>
                                        TZS @((maxChartPrice * .25m).ToString("N0"))
                                    </span>
                                    <span>
                                        TZS 0
                                    </span>
                                </div>
                                <div class="trend-chart-body">
                                    <div class="chart-grid-lines">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                    <div class="trend-bars">
                                        @foreach (var item in trendData)
                                        {
                                            var height = maxChartPrice > 0? (double)(item.Price / maxChartPrice) * 100: 0;
                                            <div class="trend-column">
                                                <div class="trend-tooltip">
                                                    <strong>
                                                        TZS @item.Price.ToString("N0")
                                                    </strong>

                                                    <small>
                                                        @item.RecordedAt.ToString("dd MMM yyyy")
                                                    </small>
                                                </div>
                                                <div class="trend-bar-container">
                                                    <div class="trend-bar"
                                                         style="height:@($"{height}%")">
                                                    </div>

                                                    <div class="trend-point">
                                                        ●
                                                    </div>

                                                </div>
                                                <small class="trend-date">
                                                    @item.RecordedAt.ToString("dd MMM")
                                                </small>

                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>
                            <div class="trend-legend">
                                <span>
                                    <i class="current"></i>
                                    Current Price
                                </span>

                                <span>
                                    <i class="minimum"></i>
                                    Min Price
                                </span>

                                <span>
                                    <i class="maximum"></i>
                                    Max Price
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="trend-empty">
                                No trend data available for the selected filters.
                            </div>
                        }

                    </section>
                    <section class="dashboard-panel regional-price-panel">
                        <div class="regional-panel-header">
                            <div>
                                <h6>
                                     Price Range by Regions
                                </h6>
                                <small class="small-word">
                                    Distribution of current market prices across regions (TZS)
                                </small>
                            </div>

                            <div class="latest-data-badge">
                                <span class="live-dot"></span>
                                Latest Data
                            </div>

                        </div>

                        @if (RegionalPriceData.Any())
                        {
                            <div class="regional-chart-content">
                                <div class="regional-donut-wrapper">

                                    <div class="regional-donut-hover">

                                        <div class="regional-donut"
                                             style="@RegionalDonutStyle">

                                            <div class="regional-donut-center">

                                                <span>Total Markets</span>

                                                <strong>
                                                    @RegionalMarketCount
                                                </strong>

                                                <small>
                                                    Regions
                                                </small>

                                            </div>

                                        </div>

                                        <div class="regional-donut-tooltip">

                                            <strong>
                                                Regional Price Distribution
                                            </strong>

                                            @foreach (var region in RegionalPriceData)
                                            {
                                                <div class="regional-tooltip-row">

                                                    <span class="regional-tooltip-region">

                                                        <i style="background:@region.Color"></i>

                                                        @region.Region

                                                    </span>

                                                    <strong>
                                                        @region.Share.ToString("0")%
                                                    </strong>

                                                </div>
                                            }

                                        </div>

                                    </div>

                                </div>
                                <div class="regional-data">

                                    <div class="regional-data-header">
                                        <span>Region</span>
                                        <span>Price Range (TZS)</span>
                                        <span>Share</span>
                                    </div>


                                    @foreach (var region in RegionalPriceData)
                                    {
                                        <div class="regional-data-row">

                                            <div class="regional-name">

                                                <span class="region-color"
                                                      style="background:@region.Color">
                                                </span>

                                                <strong>
                                                    @region.Region
                                                </strong>

                                            </div>


                                            <div class="regional-range">
                                                @region.MinPrice.ToString("N0")
                                                –
                                                @region.MaxPrice.ToString("N0")
                                            </div>


                                            <div class="regional-share">
                                                @region.Share.ToString("0")%
                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>


                            <div class="regional-chart-info">

                                <div class="info-icon">
                                    i
                                </div>

                                <div>
                                    <strong>What this shows</strong>

                                    <p>
                                        The chart shows the real price range
                                           and the share of
                                        current market prices for each region.
                                    </p>
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="trend-empty">
                                No regional price data available.
                            </div>
                        }

                    </section>

                </div>
                <section class="dashboard-panel price-panel">
                    <div class="panel-title">
                        <div class="panel-heading">
                            <h6>
                                Latest Agriculture Prices
                            </h6>

                            <small class="small-word">
                                (In 100 Kg)
                            </small>

                        </div>

                    </div>


                    <div class="table-responsive">

                        <table class="table">

                            <thead>

                                <tr>

                                    <th>
                                        Commodity
                                        <small class="small-word">
                                            (Bidhaa)
                                        </small>
                                    </th>

                                    <th>Market</th>

                                    <th>District</th>

                                    <th>Region</th>

                                    <th>
                                        Unit
                                        <small class="small-word">
                                            (In 100 Kg)
                                        </small>
                                    </th>

                                    <th>
                                        Min
                                        <small class="small-word">
                                            (In Tsh)
                                        </small>
                                    </th>

                                    <th>
                                        Price
                                        <small class="small-word">
                                            (In Tsh)
                                        </small>
                                    </th>

                                    <th>
                                        Max
                                        <small class="small-word">
                                            (In Tsh)
                                        </small>
                                    </th>

                                    <th>Type</th>
                                    <th>Date</th>


                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in FilteredPrices)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @item.Commodity
                                            </strong>
                                        </td>


                                        <td>
                                            @item.Market
                                        </td>

                                        <td>
                                            @item.District
                                        </td>

                                        <td>
                                            @item.Region
                                        </td>

                                        <td>
                                            @item.Unit
                                        </td>

                                        <td>
                                            @item.MinPrice.ToString("N0")
                                        </td>

                                        <td class="price">
                                            @item.Price.ToString("N0")
                                        </td>

                                        <td>
                                            @item.MaxPrice.ToString("N0")
                                        </td>

                                        <td>
                                            @item.PriceType
                                        </td>

                                        <td>
                                            @item.RecordedAt.ToString("dd MMM yyyy")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </section>

            </main>

        </div>

    }
</div>

@code {
    private bool loading = true;
    private List<PriceDto> prices = [];
    private List<RegionDto> regions = [];
    private string selectedRegion = "";
    private string selectedMarket = "";
    private long profitCommodityId;
    private long profitOriginMarketId;
    private decimal profitQuantity = 100;
    private bool profitLoading;
    private string? profitError;
    private List<ProfitDto> profitResults = [];
    private string selectedCommodity = "";
    private IEnumerable<PriceDto> FilteredPrices => prices.Where(x => (string.IsNullOrWhiteSpace(selectedMarket) || x.Market == selectedMarket) && (string.IsNullOrWhiteSpace(selectedCommodity) || x.Commodity == selectedCommodity));
    private decimal AverageMaxPrice => FilteredPrices.Any()? FilteredPrices.Average(x => x.MaxPrice): 0;
    private decimal AverageMinPrice => FilteredPrices.Any() ? FilteredPrices.Average(x => x.MinPrice) : 0;
    private string TopCommodity => FilteredPrices.Where(x => !string.IsNullOrWhiteSpace(x.Commodity)) .GroupBy(x => x.Commodity).OrderByDescending(x => x.Count()).Select(x => x.Key).FirstOrDefault()?? "-";
    private int CommodityCount =>FilteredPrices.Select(x => x.Commodity).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count();
    protected override async Task OnInitializedAsync()
    {
        try
        {


            var response = await service.GetPricesAsync(pageNum: 1, pageSize: 100);
            var regionResponse = await service.GetRegionsAsync(pageNum: 1, pageSize: 50);
            prices = response?.Data ?? new List<PriceDto>();
            regions = regionResponse?.Data ?? new List<RegionDto>();
            logger.LogInformation("Prices loaded: {Count}", prices.Count);
            logger.LogInformation("Regions loaded: {Count}", regions.Count);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading dashboard data");
        }
        finally
        {
            loading = false;
        }
    }    
    private IEnumerable<MarketOptionDto> OriginMarkets =>regions
        .SelectMany(r => r.Districts)
        .SelectMany(d => d.Markets)
        .Where(m => m.Id > 0 && !string.IsNullOrWhiteSpace(m.Name))
        .Select(m => new MarketOptionDto
        {
            Id = m.Id,
            Name = m.Name
        })
        .GroupBy(m => m.Id)
        .Select(g => g.First())
        .OrderBy(m => m.Name);
    private void RegionChanged()
    {
        selectedMarket = "";
        selectedCommodity = "";
    }
    private IEnumerable<string> Markets => regions
         .Where(r =>
             string.IsNullOrWhiteSpace(selectedRegion) ||
             string.Equals(
                 r.Name?.Trim(),
                 selectedRegion.Trim(),
                 StringComparison.OrdinalIgnoreCase))
         .SelectMany(r => r.Districts)
         .SelectMany(d => d.Markets)
         .Select(m => m.Name)
         .Where(x => !string.IsNullOrWhiteSpace(x))
         .Distinct()
         .OrderBy(x => x);
    private int RegionalMarketCount
    {
        get
        {
            return FilteredPrices
                .Where(x => !string.IsNullOrWhiteSpace(x.Market))
                .Select(x => x.Market)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
        }
    }
    private async Task FindProfitableMarketsAsync()
    {
        profitError = null;
        profitResults.Clear();

        if (profitCommodityId <= 0)
        {
            profitError = "Please select a commodity.";
            return;
        }

        if (profitOriginMarketId <= 0)
        {
            profitError = "Please select the origin market.";
            return;
        }

        if (profitQuantity <= 0)
        {
            profitError = "Quantity must be greater than zero.";
            return;
        }

        try
        {
            profitLoading = true;

            profitResults =await service.FindProfitableMarketsAsync(profitCommodityId,profitOriginMarketId,profitQuantity);
        }
        catch (Exception ex)
        {
            logger.LogError(
                ex,
                "Error finding profitable markets.");

            profitError =
                "Unable to calculate market opportunities.";
        }
        finally
        {
            profitLoading = false;
        }
    }
 private readonly string[] RegionChartColors =
{
    "#2878E5",
    "#45B85A",
    "#FF7A21",
    "#7351D1",
    "#249FC1",
    "#E45757",
    "#8E6BBE",
    "#14A58A"
};
    private IEnumerable<PriceDto> RegionalPriceData
    {
        get
        {
            var data = FilteredPrices
                .Where(x => !string.IsNullOrWhiteSpace(x.Region))
                .GroupBy(x => x.Region)
                .Select((group, index) =>
                {
                    var latest = group
                        .OrderByDescending(x => x.RecordedAt)
                        .First();

                    return new PriceDto
                    {
                        Region = group.Key,
                        MinPrice = group.Min(x => x.MinPrice),
                        MaxPrice = group.Max(x => x.MaxPrice),
                        CurrentPrice = latest.Price,
                        Color = RegionChartColors[index % RegionChartColors.Length]
                    };
                })
                .OrderByDescending(x => x.CurrentPrice)
                .ToList();
            var total = data.Sum(x => x.CurrentPrice);
            if (total > 0)
            {
                foreach (var item in data)
                {
                    item.Share = (item.CurrentPrice / total) * 100;
                }
            }

            return data;
        }
    }
    private string RegionalDonutStyle
    {
        get
        {
            var data = RegionalPriceData.ToList();

            if (data.Count == 0)
                return "";

            var segments = new List<string>();

            decimal current = 0;

            foreach (var item in data)
            {
                var start = current;
                var end = current + item.Share;

                segments.Add(
                    $"{item.Color} {start}% {end}%"
                );

                current = end;
            }

            return $"background: conic-gradient({string.Join(", ", segments)});";
        }
    }
    private IEnumerable<string> Commodities => prices.Select(x => x.Commodity).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private DateTimeOffset LastUpdated =>prices.Count == 0 ? DateTimeOffset.MinValue: prices.Max(x => x.RecordedAt);
    private IEnumerable<string> Regions => regions.Select(x => x.Name).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<PriceDto> MarketTicker => FilteredPrices.GroupBy(x => x.Commodity).Select(g => g.OrderByDescending(x => x.RecordedAt).First()).OrderByDescending(x => x.RecordedAt).Take(6);
    private int RisingCount => FilteredPrices.Count(x => GetChangePercentage(x) > 0);
    private int FallingCount =>FilteredPrices.Count(x => GetChangePercentage(x) < 0);
    private decimal GetChangePercentage(PriceDto item)
    {
        var previous = prices
            .Where(x =>
                x.Commodity == item.Commodity &&
                x.RecordedAt < item.RecordedAt)
            .OrderByDescending(x => x.RecordedAt)
            .FirstOrDefault();

        if (previous == null || previous.Price == 0)
            return 0;

        return ((item.Price - previous.Price) / previous.Price) * 100;
    }



}