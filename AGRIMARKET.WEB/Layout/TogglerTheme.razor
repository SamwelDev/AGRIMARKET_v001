@implements IDisposable
@inject ThemeWrapper Theme
@inject IJSRuntime JS
@inject ILogger<TogglerTheme> Logger

<i class="bi @(Theme.IsDark ? "bi-sun-fill" : "bi-moon-fill")" @onclick="Toggle" style="cursor:pointer;"></i>

@code {
    private Action? _onThemeChanged;

    protected override void OnInitialized()
    {
        _onThemeChanged = () => InvokeAsync(StateHasChanged);
        Theme.OnChange += _onThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var savedTheme = await JS.InvokeAsync<string?>("agriTheme.get");

        if (savedTheme == "dark")
        {
            Theme.Set(true);
        }
        else
        {
            Theme.Set(false);
        }

        await ApplyTheme();
    }

    private async Task Toggle()
    {
        Theme.Toggle();

        await ApplyTheme();

        Logger.LogInformation(
            "Theme changed to {Theme}",
            Theme.IsDark ? "dark" : "light");
    }

    private Task ApplyTheme()
    {
        return JS.InvokeVoidAsync(
            "agriTheme.set",
            Theme.IsDark ? "dark" : "light").AsTask();
    }

    public void Dispose()
    {
        if (_onThemeChanged != null)
        {
            Theme.OnChange -= _onThemeChanged;
        }
    }
}
